{
  "manifest_version": 3,
  "name": "本地 WebRTC 保护",
  "version": "1.0.0",
  "description": "项目自带的离线 WebRTC 保护扩展；可能影响网页通话。",
  "minimum_chrome_version": "119",
  "key": "",
  "permissions": [
    "privacy"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "block.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
